# ── Trigger.dev ────────────────────────────────────────────────────────────────
# cloud.trigger.dev → your NEW onboarding project → API keys → "dev" secret key (tr_dev_...)
TRIGGER_SECRET_KEY=

# ── Google (Sheets + Drive) ────────────────────────────────────────────────────
# Service account key JSON on ONE line (Google Cloud → IAM → Service accounts → Keys → Add key → JSON).
# Share the sheet (Editor) and the policy folder (Viewer) with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long ID in the onboarding sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
ONBOARDING_SHEET_ID=
# The ID in the Drive folder's URL: drive.google.com/drive/folders/<THIS>
# Only files in this folder are "approved policy". Upload the files from policies/ into it.
POLICY_DRIVE_FOLDER_ID=

# ── Gmail ──────────────────────────────────────────────────────────────────────
# Gmail address that sends all onboarding email. Dummy people get +aliases of it (you+dana@, you+it@, ...).
ONBOARDING_GMAIL_USER=
# Google Account → Security → 2-Step Verification → App passwords → create one named "onboarding"
ONBOARDING_GMAIL_APP_PASSWORD=
# Where employees email policy questions. Leave empty for <you>+helpdesk@gmail.com
HELPDESK_INBOX_ADDRESS=
# Where failure alerts go (you, the automation owner)
ALERT_EMAIL_TO=

# ── Claude (policy answers only) ───────────────────────────────────────────────
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Model for policy answers
POLICY_MODEL=claude-sonnet-5-5

# ── Approval links (Cloudflare Worker relay) ───────────────────────────────────
# The Worker's URL after `npm run relay:deploy`, e.g. https://onboarding-approvals.<you>.workers.dev
APPROVAL_RELAY_URL=
# Random secret that signs links. Must be the SAME value as the Worker's APPROVAL_LINK_SECRET.
APPROVAL_LINK_SECRET=

# ── Demo ───────────────────────────────────────────────────────────────────────
COMPANY_NAME=Northwind Labs
# Shrinks waits for demos: 720 → 24h becomes 2 min (remind 2 min, escalate 4 min, stall 10 min).
# Not uploaded to production (trigger.config.ts strips it), so production always runs in real time.
DEMO_TIME_SCALE=720
